# ============================================================================
# Maintainer's Copilot — DEV-ONLY .env
#
# Copy to `.env` only for fully-local development without Vault. Every line
# tagged `# DEV ONLY` is a fallback secret the API would normally read from
# Vault. NEVER commit the real values; NEVER deploy this file shape to
# production. Use `.env.example` (Vault-only) as your starting point in
# production.
#
# To switch to the Vault path:
#   1) start the in-compose `vault` service: docker compose up -d vault
#   2) seed Vault: python scripts/seed_vault.py
#   3) set VAULT_REQUIRED=true and remove the DEV ONLY lines below
# ============================================================================

# ---------- API ----------
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8501,http://localhost:5173,http://localhost:8080

# ---------- Auth ----------
# DEV ONLY: AUTH_REQUIRED=false leaves /admin/* open so a developer can curl.
# Flip to true (and set JWT_SECRET via Vault) before exposing the API.
AUTH_REQUIRED=false
JWT_SECRET=                                              # DEV ONLY (Vault: jwt_secret)
JWT_LIFETIME_SECONDS=3600
ADMIN_EMAIL=admin@example.com                            # DEV ONLY
ADMIN_PASSWORD=change-me                                 # DEV ONLY

# ---------- Frontends ----------
CHATBOT_PORT=8501
WIDGET_PORT=5173
HOST_PORT=8080
CHATBOT_USER=admin                                       # DEV ONLY (Streamlit dev login)
CHATBOT_PASSWORD=copilot                                 # DEV ONLY

# ---------- LLM (Groq via OpenAI-compatible client) ----------
OPENAI_API_KEY=                                          # DEV ONLY (Vault: openai_api_key)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ---------- RAG runtime knobs (non-secret) ----------
RAG_REQUIRED=false
RAG_VALIDATE_EMBEDDINGS=true
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_MODEL=llama-3.1-8b-instant
RAG_TOP_K=5
RAG_RETRIEVAL_TOP_K=10
RAG_MIN_RETRIEVAL_SCORE=0.35
RAG_HYBRID_ALPHA=0.65
RAG_RERANK_ENABLED=true
RAG_RERANKER_MODE=semantic
# RAG_RERANKER_MODE=cross_encoder
VECTOR_STORE_BACKEND=faiss
RAG_RETRIEVAL_MODE=hybrid

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379
CHAT_MEMORY_TTL_SECONDS=3600
CHAT_MEMORY_MAX_TURNS=6
CHAT_MEMORY_MAX_CONTEXT_CHARS=1500

# ---------- Safety ----------
# SAFETY_BLOCKLIST_EXTRA=pattern1|pattern2

# ---------- PostgreSQL ----------
POSTGRES_USER=copilot                                    # DEV ONLY
POSTGRES_PASSWORD=copilot                                # DEV ONLY
POSTGRES_DB=copilot
POSTGRES_PORT=5432
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot  # DEV ONLY (Vault: database_url)

# ---------- MinIO ----------
MINIO_ROOT_USER=minioadmin                               # DEV ONLY
MINIO_ROOT_PASSWORD=minioadmin                           # DEV ONLY
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=copilot
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin                              # DEV ONLY (Vault: minio_access_key)
MINIO_SECRET_KEY=minioadmin                              # DEV ONLY (Vault: minio_secret_key)
MINIO_SECURE=false
MINIO_UPLOAD_REPORTS=false

# ---------- Vault (dev-mode container) ----------
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token                   # DEV ONLY
VAULT_PORT=8200
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dev-root-token                               # DEV ONLY
VAULT_SECRET_PATH=copilot
VAULT_KV_MOUNT=secret
VAULT_REQUIRED=false

# ---------- Widget loader ----------
WIDGET_BASE_URL=http://localhost:5173
PUBLIC_API_URL=
# UUID of the demo widget row. After `alembic upgrade head`, run:
#   python scripts/seed_demo_widget.py
DEMO_WIDGET_ID=00000000-0000-0000-0000-000000000000

# ---------- Observability ----------
OTEL_SERVICE_NAME=maintainers-copilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
SKIP_CLASSIFIER_SHA_CHECK=false
# SKIP_RAG_THRESHOLD_CHECK=false
