# ============================================================================
# Maintainer's Copilot — production-style .env
#
# Rubric: ".env holds only the Vault root token and ports."
#
# Every secret in production is loaded FROM VAULT. This file therefore only
# carries:
#   1. The Vault root token (so the API can authenticate against Vault at
#      startup).
#   2. Service ports (non-secret).
#   3. Non-secret feature toggles (AUTH_REQUIRED, VAULT_REQUIRED, …).
#
# For a fully-local developer setup (no Vault available), copy
# `.env.dev.example` to `.env` instead — it carries dev-mode fallback secrets
# clearly marked DEV ONLY.
# ============================================================================

# ---------- Vault root token ----------
# In compose this matches the VAULT_DEV_ROOT_TOKEN_ID below. In production,
# set this to your real Vault token (and DO NOT commit it).
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-root-token
VAULT_SECRET_PATH=copilot
VAULT_KV_MOUNT=secret
# Refuse to boot if Vault is unreachable. Always true in production.
VAULT_REQUIRED=true
# Used by the in-compose `vault` service in dev mode only.
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token

# ---------- Ports ----------
API_PORT=8000
CHATBOT_PORT=8501
WIDGET_PORT=5173
HOST_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# ---------- Non-secret runtime toggles ----------
LOG_LEVEL=INFO
AUTH_REQUIRED=true
# Demo widget id used by host/ to embed the widget. Run
# `python scripts/seed_demo_widget.py` after `alembic upgrade head` to insert
# the matching widget row.
DEMO_WIDGET_ID=00000000-0000-0000-0000-000000000000

# ---------- Optional non-secret upload toggle ----------
# Tells the API to push reports/*.json + reports/*.md to MinIO on every boot.
MINIO_UPLOAD_REPORTS=true

# ============================================================================
# Secrets below this line live in VAULT, not here.
#
#   openai_api_key   → OPENAI_API_KEY
#   database_url     → DATABASE_URL
#   jwt_secret       → JWT_SECRET
#   minio_access_key → MINIO_ACCESS_KEY
#   minio_secret_key → MINIO_SECRET_KEY
#   minio_bucket     → MINIO_BUCKET
#   minio_endpoint   → MINIO_ENDPOINT
#
# Seed Vault dev secrets with:
#   python scripts/seed_vault.py
# ============================================================================
